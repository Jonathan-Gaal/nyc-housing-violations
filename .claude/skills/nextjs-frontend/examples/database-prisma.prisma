// examples/database-prisma.prisma
// Production-grade Prisma schema
// Pattern: Type-safe database queries, migrations, relationships

// ============================================================================
// DATASOURCE & GENERATOR
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // Enable full-text search
  previewFeatures = ["fullTextSearch"]
}

// ============================================================================
// MODELS
// ============================================================================

model User {
  // Primary key
  id        String   @id @default(cuid())
  
  // Auth
  email     String   @unique
  password  String   // Hash only
  role      String   @default("user") // "user" | "admin"
  
  // Profile
  name      String?
  avatar    String?
  bio       String?
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  posts     Post[]
  comments  Comment[]
  sessions  Session[]
  
  // Indexes
  @@index([email])
  @@index([createdAt])
}

model Post {
  // Primary key
  id        String   @id @default(cuid())
  
  // Content
  title     String
  content   String   @db.Text
  tags      String[] @default([])
  
  // Status
  published Boolean  @default(false)
  
  // Author
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  comments  Comment[]
  
  // Indexes
  @@index([authorId])
  @@index([published])
  @@index([createdAt])
}

model Comment {
  // Primary key
  id        String   @id @default(cuid())
  
  // Content
  text      String   @db.Text
  
  // Relations
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Indexes
  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
}

model Session {
  // Primary key
  id        String   @id @default(cuid())
  
  // Session data (for NextAuth)
  sessionToken String @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Expiration
  expires   DateTime
  
  // Indexes
  @@index([userId])
  @@index([expires])
}

