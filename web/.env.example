# Supabase pooled connection (Transaction mode, port 6543) — see Supabase dashboard > Project Settings > Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres

# NYC Open Data (Socrata) app token — raises the shared anonymous rate limit.
# Register at https://data.cityofnewyork.us/profile/app_tokens
# Sent via the X-App-Token request header only, never in a URL or logged.
# See context/API_INTEGRATION.md §4.
NYC_APP_TOKEN=your_token_here

# Shared secret Vercel Cron signs into the Authorization header
# (`Authorization: Bearer $CRON_SECRET`) when it invokes /api/cron/sync.
# Generate a random value (e.g. `openssl rand -hex 32`); the route rejects
# any request missing or mismatching this value with a 401.
CRON_SECRET=your_cron_secret_here

# No Mapbox token needed — web/components/MapView.tsx renders the
# violations heatmap with Leaflet + OpenStreetMap tiles, which require no
# API key or account.

# Firebase Admin SDK service account key, server-only (never NEXT_PUBLIC_).
# Download the JSON key file from Firebase Console > Project Settings >
# Service Accounts > Generate new private key, then collapse it to a single
# line (e.g. `jq -c . serviceAccountKey.json`) and paste it here. Used by
# web/lib/firebaseAdmin.ts to verify ID tokens server-side. Never log this
# value or commit a real key.
FIREBASE_ADMIN_SDK_KEY={"type":"service_account","project_id":"YOUR-PROJECT-ID","private_key_id":"...","private_key":"...","client_email":"..."}

# Firebase Web SDK API key, client-exposed by Firebase's own design (scoped
# by Firebase Auth's domain/API restrictions, not a secret in the traditional
# sense). Not wired up until Phase 12's client-side login/signup UI — the env
# var contract is documented here so it's established once. Find it at
# Firebase Console > Project Settings > General > Your apps > Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key_here

# Stripe secret key, server-only (never NEXT_PUBLIC_). Used by
# web/lib/stripe.ts to create Stripe customers and Checkout sessions
# server-side. Use your Stripe test-mode secret key (starts with sk_test_)
# for local development. Find it at
# https://dashboard.stripe.com/test/apikeys
# No real Stripe account/test-mode keys exist yet for this project — see
# specs/016-stripe-premium-tier.md's credential-blocked note. Never log this
# value or commit a real key.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe webhook signing secret, server-only (never NEXT_PUBLIC_). Used by
# web/app/api/webhooks/stripe/route.ts to verify that incoming webhook
# payloads genuinely came from Stripe before trusting them (mandatory —
# see spec 016's Design Pattern: webhook-as-source-of-truth for payment
# state). Obtained from the Stripe CLI (`stripe listen --print-secret`) for
# local development, or from the webhook endpoint's settings page in the
# Stripe dashboard for a deployed environment. Never log this value.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here

# Stripe publishable key, client-exposed by Stripe's own design (safe to
# ship to the browser bundle). Not required by the current Checkout-redirect
# implementation (web/app/api/users/upgrade/route.ts returns a hosted
# Checkout URL for the client to redirect to, so no client-side Stripe.js is
# needed) — included for completeness per spec 016's env var list, in case a
# future custom Stripe Elements form is added instead. Find it at
# https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
