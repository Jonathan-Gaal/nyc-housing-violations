{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "load-data": "tsx scripts/load-csv.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage",
    "test:pre-commit": "npm run lint && npm run type-check && npm run test -- --run",
    "test:pre-push": "npm run build && npm run test:coverage && npm run e2e",
    "test:all": "npm run lint && npm run type-check && npm run test -- --run && npm run build && npm run e2e",
    "prepare": "if [ -z \"$VERCEL\" ]; then cd .. && node web/node_modules/husky/bin.js .husky; fi"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "chart.js": "^4.5.1",
    "csv-parse": "^7.0.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "leaflet": "^1.9.4",
    "next": "16.3.0",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
